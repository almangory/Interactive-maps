@echo off
chcp 65001 > nul
title جدولة النسخ الاحتياطي الأسبوعي التلقائي في ويندوز

echo ================================================================================
echo           جدولة النسخ الاحتياطي التلقائي الأسبوعي في ويندوز
echo                   شركة المياه الوطنية - منصة الخرائط التفاعلية
echo ================================================================================
echo.
echo سيتم تسجيل مهمة تلقائية في Windows Task Scheduler لتعمل كل يوم أحد الساعة 2:00 صباحاً.
echo.

set TASK_NAME=NWC_InteractiveMaps_WeeklyBackup
set SCRIPT_PATH=%~dp0run_weekly_backup.bat

schtasks /create /tn "%TASK_NAME%" /tr "\"%SCRIPT_PATH%\"" /sc WEEKLY /d SUN /st 02:00 /f

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ================================================================================
    echo 🎉 تم إنشاء الجدولة الأسبوعية بنجاح!
    echo ⏰ ستعمل أداة النسخ الاحتياطي تلقائياً كل أسبوع (يوم الأحد الساعة 02:00 ص).
    echo ================================================================================
) else (
    echo.
    echo ⚠️ يرجى تشغيل هذا الملف كمسؤول (Run as Administrator) لمنح صلاحيات الجدولة في ويندوز.
)

echo.
pause
